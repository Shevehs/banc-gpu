# The settings of the bench. One file for both ways of running it (README, section 2):
#   copy it:  cp .env.example .env     (.env is ignored by git: it holds keys)
#   on your machine:  source .env      (in each terminal; the interface also reads it when it starts)
#   with Docker:      docker compose up -d     (Compose reads it; no source)
# Keep plain lines `export NAME=value`: no $VAR, no backticks, no command. An empty value is written "" (never
# `NAME=` followed by a comment: Docker Compose would take the comment as the value).

# --- The connection to your model (always needed) ---
# On your machine: http://127.0.0.1:8000. With Docker, the address the container sees:
# http://host.docker.internal:8000 for a vLLM on this machine (127.0.0.1 would be the container itself).
# The target is vLLM, or the LiteLLM gateway (then http://host.docker.internal:4000, or http://litellm:4000 with the gateway profile below).
export BENCH_URL=http://<vllm-server>:8000
# The name vLLM serves (--served-model-name), or the LiteLLM alias.
export BENCH_MODEL=bench
# vLLM's /metrics URLs, separated by spaces. Empty if BENCH_URL already points at vLLM; required when it is LiteLLM.
export BENCH_METRICS=""
# The key of the target (vLLM --api-key, or a LiteLLM key). With Docker it is visible with `docker inspect`.
export BENCH_API_KEY=""
# The tokenizer: the model's Hugging Face name (public model) or a folder; empty = tools/tokenizer.
export BENCH_TOKENIZER=""
# No usage statistics. Do not set HF_HUB_OFFLINE here: with a local tokenizer, AIPerf fails when it is set.
export DO_NOT_TRACK=1

# --- Docker Compose only (none is needed for a first run; ignored on your machine) ---

# The interface and the results
# export BENCH_PORT=8765           # the interface, on 127.0.0.1 of this machine
# export BENCH_TOKEN="a-long-random-string"   # at least 16 characters; without it, a random one is used, shown by `docker compose logs bench`
# export BENCH_UID=1000            # Linux: id -u, so that the results are yours and not root's
# export BENCH_GID=1000            # id -g
# export BENCH_TOKENIZER_REPO=org/model   # the model's Hugging Face name: its tokenizer is downloaded once into tools/tokenizer/
# export HF_TOKEN="hf_..."                 # only if that model is gated (visible with `docker inspect`; keep this file private: chmod 600 .env)
# export BENCH_ALLOW_PUBLIC_URLS=1   # only if the GPU server has a public address (the interface refuses it otherwise)

# Prometheus (the one of Compose, or your own)
# export PROMETHEUS_PORT=9090
# export BENCH_PROMETHEUS=http://prometheus:9090   # another Prometheus (then run only bench: README, section 5.3)
# export BENCH_LITELLM_SELECTOR='job="litellm"'    # the LiteLLM job of your Prometheus, for the per-agent view

# --- Only if Docker runs LiteLLM for you (README, section 6.2; also edit docker/litellm-config.yaml) ---
# Skip all of it if you already run LiteLLM: then only BENCH_URL and the other connection lines above matter.
# export COMPOSE_PROFILES=gateway
# export PROMETHEUS_CONFIG=prometheus-gateway.yml   # Prometheus also scrapes this LiteLLM
# export LITELLM_MASTER_KEY=sk-change-me       # the admin key of LiteLLM (BENCH_API_KEY above can be this key; BENCH_URL=http://litellm:4000)
# export LITELLM_DB_PASSWORD=change-me         # its database (letters and digits only)
# export LITELLM_PORT=4000
# export LITELLM_TAG=v1.110.1                  # the LiteLLM release
# export VLLM_API_BASE=http://host.docker.internal:8000/v1     # the vLLM behind LiteLLM, as seen from the container
# export VLLM_API_KEY="..."                                    # only if vLLM was started with --api-key

# --- To try everything without a GPU (and BENCH_URL=http://fake-server:8001 above) ---
# export COMPOSE_PROFILES=try
# export PROMETHEUS_CONFIG=prometheus-fake.yml
# export BENCH_LITELLM_SELECTOR='job="litellm"'
