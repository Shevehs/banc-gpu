# Choices of the Docker Compose (README, section 4.4). Copy to .env: cp .env.example .env
# This one file is all you set with Docker (no target.env). Plain KEY=value lines, no `export`.

# The connection to your model, as the container sees it (127.0.0.1 would be the container itself):
# BENCH_URL=http://host.docker.internal:8000      # your vLLM, or LiteLLM (http://host.docker.internal:4000)
# BENCH_MODEL=org/model                           # the name vLLM serves (--served-model-name), or the LiteLLM alias
# BENCH_API_KEY=                                   # key of the target (vLLM --api-key, or a LiteLLM key)
# BENCH_METRICS=http://host.docker.internal:8000/metrics   # vLLM's /metrics: required when the target is LiteLLM
# BENCH_TOKENIZER=org/model                       # public model: its Hugging Face name; a gated model: see BENCH_TOKENIZER_REPO

# The choices of Docker Compose; none is needed for a first run (the interface and Prometheus, vLLM only).

# BENCH_UID=1000            # id -u: on Linux, results are then yours and not root's
# BENCH_GID=1000            # id -g
# BENCH_TOKEN=              # empty: random, shown by `docker compose logs bench`
# BENCH_TOKENIZER_REPO=org/model   # the model's Hugging Face name: its tokenizer is downloaded once into tools/tokenizer/
# HF_TOKEN=                        # only if that model is gated (visible with `docker inspect`; keep this file private: chmod 600 .env)
# BENCH_ALLOW_PUBLIC_URLS=1   # only if the GPU server has a public address (the interface refuses it otherwise)
# BENCH_PROMETHEUS=http://prometheus:9090   # another Prometheus (then run only bench: README, section 4.4)
# LITELLM_TAG=v1.110.1                     # the LiteLLM release
# BENCH_PORT=8765           # the interface, on 127.0.0.1 of this machine
# PROMETHEUS_PORT=9090

# With the LiteLLM gateway (also edit docker/litellm-config.yaml):
# COMPOSE_PROFILES=gateway
# PROMETHEUS_CONFIG=prometheus-gateway.yml
# LITELLM_MASTER_KEY=sk-change-me       # the admin key of LiteLLM (BENCH_API_KEY above can be this key; BENCH_URL=http://litellm:4000)
# LITELLM_DB_PASSWORD=change-me         # its database (letters and digits only)
# BENCH_LITELLM_SELECTOR='job="litellm"'
# LITELLM_PORT=4000
# VLLM_API_BASE=http://host.docker.internal:8000/v1     # the vLLM behind LiteLLM, as seen from the container
# VLLM_API_KEY=                                          # only if vLLM was started with --api-key

# To try everything without a GPU (and BENCH_URL=http://fake-server:8001 above):
# COMPOSE_PROFILES=try
# PROMETHEUS_CONFIG=prometheus-fake.yml
# BENCH_LITELLM_SELECTOR='job="litellm"'
