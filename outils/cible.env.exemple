# Réglages de connexion, à copier en cible.env (ignoré par git), à remplir, puis à charger
# dans chaque terminal :  source cible.env
# Cible des requêtes : vLLM directement (mesure des GPU) ou la passerelle LiteLLM
export URL=http://<serveur-vllm>:8000
# Nom servi par vLLM (--served-model-name) ou alias LiteLLM
export MODELE=banc
# URL /metrics de vLLM, séparées par des espaces ; vide si URL vise déjà vLLM
export METRIQUES=""
# Clé d'API de la cible (vLLM --api-key, ou clé LiteLLM). Ne pas versionner ce fichier.
export CLE_API=""
# Tokenizer pour la charge synthétique ; vide = outils/tokenizer du dépôt
export TOKENIZER=""
# Pas de statistiques d'usage. Ne pas mettre HF_HUB_OFFLINE ici : avec un tokenizer local,
# AIPerf 0.12 échoue quand cette variable est active (balayage.sh la retire de toute façon pour AIPerf).
export DO_NOT_TRACK=1
