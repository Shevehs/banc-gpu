# Connection settings: copy to target.env (ignored by git), fill in, then load
# in each terminal:  source target.env
# The interface (python -m interface.server) also reads this file when it starts: keep plain
# lines  export BENCH_NAME=value  (no $VAR, no backticks, no command).
# Settings are read from the BENCH_* variables.
# This file is for the install on the machine. With Docker Compose, set the connection in .env instead
# (.env.example; addresses as the container sees them): README, sections 2.2 and 4.4.
# Request target: vLLM directly (GPU measurement) or the LiteLLM gateway
export BENCH_URL=http://<vllm-server>:8000
# Name served by vLLM (--served-model-name) or LiteLLM alias
export BENCH_MODEL=bench
# vLLM /metrics URLs, separated by spaces; empty if BENCH_URL already points at vLLM
export BENCH_METRICS=""
# API key for the target (vLLM --api-key, or LiteLLM key). Do not commit this file.
export BENCH_API_KEY=""
# Tokenizer (synthetic load, AgentX, test agents); empty = the repository's tools/tokenizer
export BENCH_TOKENIZER=""
# No usage statistics. Do not set HF_HUB_OFFLINE here: with a local tokenizer,
# AIPerf fails when this variable is set (sweep.sh unsets it for AIPerf anyway).
export DO_NOT_TRACK=1
